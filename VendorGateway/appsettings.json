{
  "AppSettings": {
    "Mode": "Development"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DefaultVendor": "FakeStore",
  "VendorSettings": {
    "VendorDetails": [
      {
        "Name": "FakeStore",
        "ApiUrl": "https://fakestoreapi.com",
        "TimeoutSeconds": 10,
        "Products": {
          "GetAll": "/products",
          "Delete": "/products/{id}"
        },
        "Users": {
          "Create": "/users",
          "Get": "/users/{id}",
          "Update": "/users/{id}",
          "Delete": "/users/{id}"
        }
      }
    ]
  }
}
 